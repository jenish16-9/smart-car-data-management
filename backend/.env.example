APP_NAME=Smart Car Data Management API
API_PREFIX=/api/v1
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_car
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=smart_car
DEVICE_DELAYED_AFTER_SECONDS=90
DEVICE_OFFLINE_AFTER_SECONDS=300
AUDIO_CLASSIFIER_BACKEND=mock
AUDIO_MODEL_PATH=ml_artifacts/audio-baseline.joblib
AUDIO_UPLOAD_MAX_BYTES=10000000

JWT_SECRET=replace-this-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development login. Only used when ENVIRONMENT=development.
# Leave DEV_ADMIN_EMAIL empty to disable seeding.
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=admin123

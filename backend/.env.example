APP_NAME=Smart Car Data Management API
API_PREFIX=/api/v1
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# Shared cloud development databases (placeholders only: put real values in your own, git-ignored .env).
# Passwords with special characters must be URL-encoded, see README "Cloud development databases".
POSTGRES_URL=postgresql+asyncpg://dev_user:CHANGE_ME@your-postgres-host/smart_car_dev
MONGODB_URL=mongodb+srv://dev_user:CHANGE_ME@your-cluster.mongodb.net/
MONGODB_DATABASE=smart_car_dev
# Local alternative:
#   POSTGRES_URL=postgresql+asyncpg://your_user@localhost:5432/smart_car
#   MONGODB_URL=mongodb://localhost:27017

DEVICE_HEARTBEAT_TIMEOUT_SECONDS=300
LOW_BATTERY_WARNING_PERCENT=15
DEVICE_DELAYED_AFTER_SECONDS=90
DEVICE_OFFLINE_AFTER_SECONDS=300
AUDIO_CLASSIFIER_BACKEND=mock
AUDIO_MODEL_PATH=ml_artifacts/audio-baseline.joblib
AUDIO_UPLOAD_MAX_BYTES=10000000

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development login. Only used when ENVIRONMENT=development.
# Leave DEV_ADMIN_EMAIL empty to disable seeding.
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=CHANGE_ME

# Optional: password for the demo driver account (driver@example.com) created by the seed script.
# Leave empty to skip creating that account.
DEMO_DRIVER_PASSWORD=
